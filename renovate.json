{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": [
    "before 9am on saturday"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "semanticCommitType": "chore",
  "baseBranchPatterns": [
    "master"
  ],
  "enabledManagers": [
    "gomod",
    "custom.regex"
  ],
  "branchPrefix": "renovate/",
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "packageRules": [
    {
      "description": "the go and toolchain directives are bumped outside Renovate",
      "matchDepTypes": [
        "golang",
        "toolchain"
      ],
      "enabled": false
    },
    {
      "description": "stringer is a tool directive of go.mod: go get -tool marks golang.org/x/tools indirect (no package imports it) and Renovate skips indirect deps by default; gomodTidy keeps the tool block",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "indirect"
      ],
      "matchPackageNames": [
        "golang.org/x/tools"
      ],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "shellcheck release installed by the CI lint job",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "SHELLCHECK_VERSION: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "koalaman/shellcheck",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
